{
  "js": "function setupPost(post) {\n    post.addEventListener('click', () => {\n        post.classList.toggle('active');\n    });\n    const links = post.querySelectorAll('a');\n    links.forEach(link => {\n        link.target = \"_new\";\n    })\n}\ndocument.title = \"Occulto Developer\";\nconst postsContainer = document.querySelector('.posts-container');\nconst postsToggle = document.querySelector('.posts-container > h2 > .fa-solid');\nasync function getPosts() {\n    const URL = \"https://raw.githubusercontent.com/OccultoStudios/OccultoStudios.github.io/refs/heads/main/posts.json\";\n    const res = await fetch(URL);\n    const data = await res.json();\n\n    data.forEach(async post => {\n        const postElement = document.createElement('div');\n        postElement.className = \"post\";\n        const postTitle = document.createElement('b');\n        postTitle.innerText = post.title;\n        postElement.appendChild(postTitle);\n        const postContent = document.createElement('span');\n        var content = post.desc;\n        if(content.startsWith('!GetData')) {\n            const url = content.split(\"!GetData \")[1];\n            const new_data = await fetch(url);\n            const str = await new_data.text();\n            postContent.innerHTML = str;\n        } else {\n            postContent.innerHTML = content;\n        }\n        \n        postElement.appendChild(postContent);\n        postsContainer.appendChild(postElement);\n        setupPost(postElement);\n    })\n}\ngetPosts();\n\npostsToggle.addEventListener('click', ()=>{\n    postsToggle.classList.toggle(\"fa-eye-low-vision\");\n    postsToggle.classList.toggle(\"fa-eye\");\n    postsContainer.classList.toggle('hide-posts');\n});",
  "css": "/* CSS */\nhtml,\nbody {\n    background: #111;\n    color: white;\n    width: 100vw;\n    height: 100vh;\n    padding: 0;\n    margin: 0;\n    overflow-x: hidden;\n    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;\n}\n\n.col-layout {\n    display: flex;\n    width: 100%;\n    flex-direction: column;\n}\n\n.col-item {\n    width: 100%;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n}\n\n.nav-top {\n    height: 30px;\n    position: fixed;\n    width: 100%;\n    top: 0px;\n    left: 0px;\n    margin: 0;\n    background: #00000040;\n    z-index: 2;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n}\n\n.col-sep-bottom {\n    border-bottom: 1px solid #333;\n}\n\n.header-1 {\n    background-image: url(\"https://occulto.quest/images/art_1.webp\");\n    height: 300px;\n    background-position: 50%;\n    z-index: 1;\n}\n\n.header-1>img {\n    width: 500px;\n}\n\n.post {\n    width: calc(80% - 5px);\n    max-height: calc(200px - 5px);\n    cursor: pointer;\n    overflow: hidden;\n    background-color: #222;\n    border: 1px solid #414141;\n    border-radius: 6px;\n    padding: 10px;\n    position: relative;\n    margin: 10px 0px;\n}\n\n.posts-container.hide-posts .post {\n    display: none;\n}\n\n.posts-container>h2 {\n    user-select: none;\n}\n\n.posts-container>h2>i {\n    font-size: 20px;\n    cursor: pointer;\n}\n\n.post:not(.active):after {\n    content: '';\n    position: absolute;\n    left: 0px;\n    right: 0px;\n    height: 40%;\n    bottom: 0px;\n    background: linear-gradient(180deg, rgba(139, 167, 32, 0) 0%, #222 100%);\n    pointer-events: none;\n}\n\n.post>span {\n    display: block;\n}\n\n.post.active {\n    max-height: 250px;\n    overflow-y: scroll;\n    background: #333;\n}\n\ntable {\n    background-color: #242424;\n    border: 1px solid #707070;\n    border-radius: 6px;\n    padding: 4px;\n    position: relative;\n    cursor: default;\n}\n\ntbody {\n    position: relative;\n}\n\ntbody::after {\n    content: \"\";\n    width: 100%;\n    height: 1px;\n    position: absolute;\n    top: 0;\n    left: 0;\n    background: #707070;\n}\n\ntd {\n    padding: 2px;\n}\n\n@media only screen and (max-width: 700px) {\n    .header-1>img {\n        width: 100vw;\n    }\n    .header-1>big {\n        font-size:5vw;\n    }\n    .post {\n        width: calc(100% - 40px);\n    }\n    table {\n        font-size: small;\n    }\n}",
  "html": "<div class=\"nav-top\">\n    <i class=\"fa-solid fa-shield-check\"></i>\n    developer.occulto.quest\n</div>\n<div class=\"col-layout\">\n    <div class=\"col-item header-1 col-sep-bottom\">\n        <img src=\"https://github.com/OccultoStudios/OccultoStudios.github.io/blob/main/ooccultodeveloper.png?raw=true\" alt=\"\">\n        <big>The official developer guide for Occulto.</big>\n    </div>\n    <div class=\"col-item col-sep-bottom posts-container\">\n        <h2>Posts <i class=\"fa-solid fa-eye\"></i></h2>\n    </div>\n</div>",
  "settings": {
    "cssImports": [
      "https://rsms.me/inter/inter.css",
      "https://site-assets.fontawesome.com/releases/v6.5.0/css/all.css"
    ],
    "jsImports": [],
    "color": "#6955c6",
    "borderWidth": 1
  }
}